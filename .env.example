# --- LLM provider ---
# "ollama" = free local inference via Ollama (http://localhost:11434).
# "hf"     = Hugging Face inference router (needs HF_TOKEN; for benchmarks).
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# --- Hugging Face (only needed for LLM_PROVIDER=hf) ---
HF_TOKEN=hf_xxx
# Default benchmark model:
#   tiiuae/falcon-7b-instruct
#   meta-llama/Llama-3.2-3B-Instruct
#   mistralai/Mistral-7B-Instruct-v0.2
#   microsoft/phi-2
LLM_MODEL=meta-llama/Llama-3.2-3B-Instruct
HF_INFERENCE_BASE_URL=https://router.huggingface.co/hf-inference/models/

# --- Retrieval ---
FAISS_WEIGHT=0.7
BM25_WEIGHT=0.3
RETRIEVAL_TOP_K=5
TEMPORAL_FILTER_YEARS=5          # prioritize studies from the last N years

# --- Paths ---
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_INDEX_DIR=./data/index

# --- Translation ---
DEFAULT_LANG=en
# mbart-large-50 runs locally; set only if using Google Cloud Translate
GOOGLE_TRANSLATE_API_KEY=

# --- Cache ---
REDIS_URL=redis://localhost:6379/0

# --- App ---
CORS_ORIGINS=http://localhost:5173
